  id: MEM-069
  layer: memory
  name: 记忆写入失败（有读无写）
  scope: observable
  severity: P1
  sql_template: "SELECT system, COUNT(*) as retrieve_cnt FROM events\nWHERE event_type='memory_retrieve'\
    \ AND timestamp > ?\nAND NOT EXISTS (\n  SELECT 1 FROM events e2\n  WHERE e2.system\
    \ = events.system\n  AND e2.event_type = 'memory_store'\n  AND e2.timestamp >\
    \ ?\n)\nGROUP BY system HAVING retrieve_cnt > 10\n"
