  layer: probe
  name: 业务埋点质量差
  scope: observable
  severity: P1
  sql_template: "SELECT system,\n  SUM(CASE WHEN json_extract(payload, '$._incomplete')\
    \ = 1 THEN 1 ELSE 0 END) as incomplete,\n  COUNT(*) as total\nFROM events\nWHERE\
    \ timestamp > ?\nAND event_type = '__health__'\nGROUP BY system\nHAVING total\
    \ > 0 AND (incomplete * 100.0 / total) > 10\n"
