  name: 探针 emit 率异常
  scope: observable
  severity: P2
  sql_template: "SELECT system, json_extract(payload, '$.emit_success_count_1m') as\
    \ emit_rate\nFROM events WHERE event_type='__health__' AND timestamp > ?\nAND\
    \ json_extract(payload, '$.emit_success_count_1m') IS NOT NULL\nAND json_extract(payload,\
    \ '$.emit_success_count_1m') < 2\nAND EXISTS (\n  SELECT 1 FROM events e2\n  WHERE\
    \ e2.system = events.system\n  AND e2.event_type NOT IN ('__health__', '__register__')\n\
    \  AND e2.timestamp > ?\n)\nORDER BY emit_rate ASC LIMIT 5\n"
