    GROUP BY system

    '
- applicable: all
  depends:
    event_types:
    - llm_invoke
    fields:
    - layer_llm.output_tokens
    - layer_network.status_code
  description: LLM 返回 200 但无输出内容，可能是提示词问题
  id: MDL-031
  layer: model
  name: LLM 空返回
  scope: observable
  severity: P2
  sql_template: 'SELECT system, COUNT(*) as cnt FROM events

    WHERE event_type='llm_invoke' AND timestamp > ?

    AND json_extract(payload, '\1') = 0

    AND json_extract(payload, '\1') = 200

    GROUP BY system

    '
- applicable: all
  depends:
    event_types:
    - llm_invoke
    fields:
    - layer_llm.input_tokens
    - layer_llm.output_tokens
  description: 输入 token 远超输出，提示词可能过于冗长
  id: MDL-032
  layer: model
  name: 提示词臃肿
  per_system:
    opencode:
      confidence_multiplier: 0.7
  scope: observable
  severity: P2
  sql_template: "SELECT system, AVG(json_extract(payload, '$.layer_llm.input_tokens')\
    \ * 1.0 /\n       NULLIF(json_extract(payload, '$.layer_llm.output_tokens'), 0))\
    \ as ratio\nFROM events WHERE event_type='llm_invoke' AND timestamp > ?\nAND json_extract(payload,\
    \ '$.layer_llm.output_tokens') > 0\nGROUP BY system HAVING ratio > 60\n"
- applicable: all
  depends:
    event_types:
    - llm_invoke
    fields:
    - layer_llm.latency_ms
    - layer_llm.model
  description: 特定模型响应延迟超过 5 秒
  id: MDL-033
  layer: model
  name: 特定模型高延迟
  per_system:
    opencode:
      confidence_multiplier: 0.7
  scope: observable
  severity: P1
  sql_template: "SELECT system,\n       json_extract(payload, '$.layer_llm.model')\
    \ as model,\n       COUNT(*) as cnt\nFROM events WHERE event_type='llm_invoke'\
    \ AND timestamp > ?\nAND json_extract(payload, '$.layer_llm.latency_ms') > 30000\n\
    GROUP BY system, model\n"
- applicable: all
  depends:
    event_types:
    - llm_invoke
    fields:
    - layer_llm.latency_ms
  description: 延迟波动范围超过均值 2 倍，服务可能不稳定
  id: MDL-034
  layer: model
  name: Latency 抖动异常
  per_system:
    opencode:
      confidence_multiplier: 0.7
  scope: observable
  severity: P2
  sql_template: "SELECT system,\n       AVG(json_extract(payload, '$.layer_llm.latency_ms'))\
    \ as avg_lat,\n       MAX(json_extract(payload, '$.layer_llm.latency_ms')) - MIN(json_extract(payload,\
    \ '$.layer_llm.latency_ms')) as lat_range\nFROM events WHERE event_type='llm_invoke'\
    \ AND timestamp > ?\nGROUP BY system HAVING lat_range > avg_lat * 5\n"
- applicable: all
  depends:
    event_types:
    - agent_step
    fields:
    - layer_agent.step_id
  description: 同一决策步骤高频重复，疑似循环、震荡或缺乏终止条件
  id: MDL-035
  layer: model
  name: 无限循环与思考瘫痪
  scope: observable
  severity: P0
  sql_template: 'SELECT system, json_extract(payload, '$.layer_agent.step_id') as
    sid, COUNT(*) as c

    FROM events WHERE event_type='agent_step' AND timestamp > ?

    GROUP BY system, sid HAVING c > 5

    '
- applicable: all
  depends:
    event_types:
    - llm_invoke
    fields:
    - layer_llm.input_tokens
    - layer_llm.output_tokens
  description: Token 消耗超过阈值，检查循环调用、模型降级或长文本输入
  id: MDL-036
  layer: model
  name: 推理成本失控
  per_system:
    opencode:
      confidence_multiplier: 0.5
  scope: observable
  severity: P1
  sql_template: "SELECT system,\n       SUM(json_extract(payload, '$.layer_llm.input_tokens')\
    \ +\n            json_extract(payload, '$.layer_llm.output_tokens')) as tokens,\n\
    \       COUNT(*) as cnt\nFROM events WHERE event_type='llm_invoke' AND timestamp\
    \ > ?\nGROUP BY system HAVING tokens > 500000\n"
- applicable: all
  depends:
    event_types:
    - llm_invoke
    fields:
    - layer_llm.input_tokens
  description: 输入 token 持续接近模型上限，注意力可能稀释
  id: MDL-037
  layer: model
  name: 大规模注意力稀释
  scope: observable
  severity: P2
  sql_template: 'SELECT system, AVG(json_extract(payload, '\1'))
    as avg_tokens

    FROM events WHERE event_type='llm_invoke' AND timestamp > ?

    GROUP BY system HAVING avg_tokens > 100000

    '
- applicable: all
  depends:
    event_types:
    - llm_invoke
    - tool_call
    - agent_step
    fields:
    - timestamp
  description: LLM 调用高频但无工具调用或 agent 步骤产出，可能空转
  id: MDL-038
  layer: model
  name: 静默成本与空转浪费
  scope: observable
  severity: P1
  sql_template: "SELECT system, COUNT(*) as llm_cnt FROM events\nWHERE event_type='llm_invoke'\
    \ AND timestamp > ?\nAND NOT EXISTS (\n  SELECT 1 FROM events e2\n  WHERE e2.system\
    \ = events.system\n  AND e2.event_type IN ('tool_call', 'agent_step')\n  AND e2.timestamp\
    \ > ?\n)\nGROUP BY system HAVING llm_cnt > 50\n"
- applicable: all
  depends:
    event_types:
    - tool_call
    fields:
    - layer_tool.tool_status
  description: 工具调用超时，依赖服务可能不可用
  id: TLT-039
  layer: tool
  name: 工具调用超时
  scope: observable
  severity: P1
  sql_template: 'SELECT system, COUNT(*) as cnt FROM events

    WHERE event_type='tool_call' AND timestamp > ?

    AND json_extract(payload, '\1') = '\1'

    GROUP BY system

    '
- applicable: all
  depends:
    event_types:
    - tool_call
    fields:
    - layer_tool.tool_input_hash
  description: 相同工具输入 5 分钟内重复超过 3 次，缓存可能失效
  id: TLT-040
  layer: tool
  name: 工具输入重复（缓存失效）
  scope: observable
  severity: P2
  sql_template: 'SELECT system, json_extract(payload, '\1')
    as h, COUNT(*) as cnt

    FROM events WHERE event_type='tool_call' AND timestamp > ?

    AND json_extract(payload, '\1') IS NOT NULL

    GROUP BY system, h HAVING cnt > 3

    '
- applicable: all
  depends:
    event_types:
    - llm_output
    fields:
    - layer_llm.output_text_hash
    - layer_agent.session_id
  description: 同一 Session 内 5 分钟内相同输出内容重复超过 3 次，疑似 LLM 重复说话
  id: TLT-051
  layer: tool
  name: LLM 重复输出（内容哈希重复）
  scope: observable
  severity: P1
  sql_template: "SELECT system, json_extract(payload, '$.layer_agent.session_id')\
    \ as session_id,\n       json_extract(payload, '$.layer_llm.output_text_hash')\
    \ as text_hash,\n       COUNT(*) as repeat_count,\n       MIN(timestamp) as first_seen,\n\
    \       MAX(timestamp) as last_seen\nFROM events\nWHERE event_type='llm_output'\n\
    \  AND timestamp > ?\n  AND json_extract(payload, '$.layer_llm.output_text_hash')\
    \ IS NOT NULL\nGROUP BY system, session_id, text_hash\nHAVING repeat_count >=\
    \ 3\n   AND (MAX(timestamp) - MIN(timestamp)) < 300\n"
- applicable: all
  depends:
    event_types:
    - agent_step_start
    - agent_step_finish
    fields:
    - layer_agent.step_id
    - layer_agent.session_id
  description: Agent 步骤开始后超过 2 分钟未完成，疑似思考停滞或卡死
  id: TLT-052
  layer: model
  name: 长时间无响应（思考停滞）
  scope: observable
  severity: P1
  sql_template: |
    SELECT s.system,
           json_extract(s.payload, '$.layer_agent.step_id') as step_id,
           s.timestamp as step_start_time
    FROM events s
    WHERE s.event_type='agent_step_start'
      AND s.timestamp > ?
      AND s.system IN ('opencode', 'crewai', 'langchain-js')
      AND json_extract(s.payload, '$.layer_agent.step_id') IS NOT NULL
      AND (strftime('%s', 'now') - s.timestamp) > 120
      AND NOT EXISTS (
        SELECT 1 FROM events f
        WHERE f.event_type='agent_step_finish'
          AND f.system = s.system
          AND json_extract(f.payload, '$.layer_agent.step_id') = json_extract(s.payload, '$.layer_agent.step_id')
          AND f.timestamp > s.timestamp
      )
- applicable: all
  depends:
    event_types:
    - tool_call
    fields:
    - layer_tool.execution_ms
  description: 工具执行耗时超过 10 秒，即使成功也异常
  id: TLT-041
  layer: tool
  name: 工具 Latency 异常高
  scope: observable
  severity: P2
  sql_template: "SELECT system, json_extract(payload, '$.layer_tool.tool_name') as\
    \ tool,\n       json_extract(payload, '$.layer_tool.execution_ms') as exec_ms\n\
    FROM events WHERE event_type='tool_call' AND timestamp > ?\nAND json_extract(payload,\
    \ '$.layer_tool.execution_ms') > 10000\n"
- applicable: all
  depends:
    event_types:
    - tool_call
    fields:
    - layer_tool.tool_name
  description: 检测到不在白名单中的工具调用 — 暂不启用（乾坤镜不做第三方工具围栏）
  id: TLT-042
  layer: tool
  name: 未知工具调用
  scope: observable
  severity: P2
  sql_template: 'SELECT system, json_extract(payload, '\1')
    as tool, COUNT(*) as cnt

    FROM events WHERE event_type='tool_call' AND timestamp > ?

    GROUP BY system, tool ORDER BY cnt DESC LIMIT 20

    '
- applicable: all
  depends:
    event_types:
    - tool_call
    - error
    fields:
    - layer_tool.tool_status
    - timestamp
  description: 工具调用成功但后续发生错误事件，可能存在下游依赖问题
  id: TLT-043
  layer: tool
  name: 工具成功但下游失败
  scope: observable
  severity: P1
  sql_template: "SELECT system, COUNT(*) as cnt FROM events\nWHERE event_type='error'\
    \ AND timestamp > ?\nAND json_extract(payload, '$.error_type') NOT LIKE '%test%'\n\
    AND EXISTS (\n  SELECT 1 FROM events e2\n  WHERE e2.system = events.system\n \
    \ AND e2.event_type = 'tool_call'\n  AND e2.timestamp > ?\n  AND json_extract(e2.payload,\
    \ '$.layer_tool.tool_status') = 'success'\n)\nGROUP BY system\n"
- applicable: all
  depends:
    event_types:
    - error
    fields:
    - error_type
  description: 工具调用因权限不足失败
  id: TLT-044
  layer: tool
  name: 工具权限不足
  scope: observable
  severity: P1
  sql_template: 'SELECT system, COUNT(*) as cnt FROM events

    WHERE event_type='error' AND timestamp > ?

    AND (json_extract(payload, '\1') LIKE '\1' OR json_extract(payload,
    '\1') LIKE '\1')

    GROUP BY system

    '
- applicable: all
  depends:
    event_types:
    - error
    fields:
    - error_type
  description: 工具调用参数格式错误
  id: TLT-045
  layer: tool
  name: 工具调用格式错误
  scope: observable
  severity: P1
  sql_template: 'SELECT system, COUNT(*) as cnt FROM events

    WHERE event_type='error' AND timestamp > ?

    AND (json_extract(payload, '\1') LIKE '\1' OR json_extract(payload,
    '\1') LIKE '\1')

    GROUP BY system

    '
- applicable: all
  depends:
    event_types:
    - tool_call
    fields:
    - layer_tool.tool_name
    - layer_tool.tool_status
  description: 工具频繁失败（3次以上），可能是选错工具或参数不当
  id: TLT-046
  layer: tool
  name: 工具选择不当
  scope: observable
  severity: P2
  sql_template: 'SELECT system, json_extract(payload, '\1')
    as tool, COUNT(*) as cnt

    FROM events WHERE event_type='tool_call' AND timestamp > ?

    AND json_extract(payload, '\1') = '\1'

    GROUP BY system, tool HAVING cnt >= 3

    '
- applicable: all
  depends:
    event_types:
    - tool_call
    fields:
    - layer_tool.tool_status
    - layer_tool.tool_name
  description: 同一工具 5 分钟内连续失败超过 3 次
  id: TLT-047
  layer: tool
  name: 工具连续失败
  scope: observable
  severity: P1
  sql_template: 'SELECT system, json_extract(payload, '\1')
    as tool, COUNT(*) as fails

    FROM events WHERE event_type='tool_call' AND timestamp > ?

    AND json_extract(payload, '\1') = '\1'

    GROUP BY system, tool HAVING fails > 3

    '
- applicable: all
  depends:
    event_types:
    - tool_call
    fields:
    - layer_tool.tool_name
  description: Agent 调用高危工具，需立即检查权限配置与 guardrail 拦截
  id: TLT-048
  layer: tool
  name: 工具权限失控
  scope: observable
  severity: P0
  sql_template: 'SELECT system, json_extract(payload, '\1')
    as tool, COUNT(*) as cnt

    FROM events WHERE event_type='tool_call' AND timestamp > ?

    AND json_extract(payload, '\1') IN ('\1',
    '\1', '\1', '\1', '\1')

    GROUP BY system, tool

    '
- applicable: all
  depends:
    event_types:
    - tool_call
    fields:
    - layer_tool.tool_name
  description: 工具调用种类过多，可能存在协同困难
  id: TLT-049
  layer: tool
  name: 多工具协同困难
  scope: observable
  severity: P1
  sql_template: 'SELECT system, COUNT(DISTINCT json_extract(payload, '\1'))
    as tool_count

    FROM events WHERE event_type='tool_call' AND timestamp > ?

    GROUP BY system HAVING tool_count > 10

    '
- applicable: all
  depends:
    event_types:
    - agent_step
    fields:
    - layer_agent.step_id
  description: 策划步骤过多且无有效产出，可能存在冗余劳动
  id: TLT-050
  layer: tool
  name: 策划步骤冗余与无效劳动
  scope: observable
  severity: P2
  sql_template: 'SELECT system, COUNT(*) as cnt FROM events

    WHERE event_type='agent_step' AND timestamp > ?

    GROUP BY system HAVING cnt > 100

    '
- applicable: all
  depends:
    event_types:
    - expectation_check
    fields: []
  description: 探针可能未覆盖该路径，或执行失败，或事件在异步/子进程中丢失
  id: AGT-049
  layer: agent
  name: 预期事件缺失
  scope: observable
  severity: P2
  sql_template: 'SELECT system, expected_event FROM expectations

    WHERE fulfilled=0 AND deadline < ?

    '
- applicable: all
  depends:
    event_types:
    - agent_step
    - llm_invoke
    fields:
    - layer_agent.session_id
  description: Session ID 频繁跳变或为 NULL，会话管理可能混乱
  id: AGT-051
  layer: agent
  name: Session 管理混乱
  scope: observable
  severity: P1
  sql_template: 'SELECT system, COUNT(DISTINCT json_extract(payload, '\1'))
    as session_count

    FROM events WHERE event_type IN ('\1', '\1') AND timestamp
    > ?

    AND json_extract(payload, '\1') IS NOT NULL

    GROUP BY system HAVING session_count > 20

    '
- applicable: all
  depends:
    event_types:
    - agent_step
    fields:
    - layer_agent.step_id
  description: 步骤 ID 序列不连续，可能存在步骤缺失 — 暂不启用（需解析复合 step_id 做 gap 检测，当前 SQL 无法支持）
  id: AGT-052
  layer: agent
  name: Step 跳跃（步骤缺失）
  scope: observable
  severity: P2
  sql_template: 'SELECT system, json_extract(payload, '$.layer_agent.step_id') as
    sid, COUNT(*) as cnt

    FROM events WHERE event_type='agent_step' AND timestamp > ?

    GROUP BY system, sid ORDER BY cnt DESC LIMIT 20

    '
- applicable: all
  depends:
    event_types:
    - agent_step
    fields:
    - layer_agent.decision_summary
  description: Agent 决策摘要为空或过短，决策过程不透明
  id: AGT-053
  layer: agent
  name: 决策黑盒
  scope: observable
  severity: P2
  sql_template: "SELECT system, COUNT(*) as cnt FROM events\nWHERE event_type='agent_step'\
    \ AND timestamp > ?\nAND (json_extract(payload, '$.layer_agent.decision_summary')\
    \ IS NULL\n     OR LENGTH(json_extract(payload, '$.layer_agent.decision_summary'))\
    \ < 10)\nGROUP BY system\n"
- applicable: all
  depends:
    event_types:
    - agent_step
    fields:
    - layer_agent.session_id
  description: 同一 Session 内步骤超过 100，可能陷入死循环
  id: AGT-054
  layer: agent
  name: 单 Session 步骤过多
  scope: observable
  severity: P2
  sql_template: 'SELECT system, json_extract(payload, '\1')
    as sid, COUNT(*) as cnt

    FROM events WHERE event_type='agent_step' AND timestamp > ?

    GROUP BY system, sid HAVING cnt > 100

    '
- applicable: all
  depends:
    event_types:
    - agent_step
    fields:
    - layer_agent.step_id
    - layer_agent.session_id
  description: 同一 Session 内 Step ID 重复，可能非循环导致
  id: AGT-055
  layer: agent
  name: Step ID 重复（非循环）
  scope: observable
  severity: P2
  sql_template: "SELECT system, json_extract(payload, '$.layer_agent.step_id') as\
    \ sid,\n       json_extract(payload, '$.layer_agent.session_id') as session,\n\
    \       COUNT(*) as cnt\nFROM events WHERE event_type='agent_step' AND timestamp\
    \ > ?\nGROUP BY system, sid, session HAVING cnt > 1\n"
- applicable: all
  depends:
    event_types:
    - agent_step
    fields:
    - layer_agent.role
  description: Agent 角色与事件类型不匹配，可能存在边界侵蚀 — 暂不启用（需角色/事件映射表，当前 Schema 无法支持）
  id: AGT-056
  layer: agent
  name: 角色边界侵蚀
  scope: observable
  severity: P1
  sql_template: 'SELECT system, json_extract(payload, '\1') as role,
    COUNT(*) as cnt

    FROM events WHERE event_type='agent_step' AND timestamp > ?

    AND json_extract(payload, '\1') IS NOT NULL

    GROUP BY system, role

    '
- applicable: all
  depends:
    event_types:
    - agent_step
    - llm_invoke
    fields:
    - layer_agent.session_id
  description: 多 Session 事件串扰，可能存在并发一致性冲突
  id: AGT-057
  layer: agent
  name: 并发一致性冲突
  scope: observable
  severity: P0
  sql_template: 'SELECT system, COUNT(DISTINCT json_extract(payload, '\1'))
    as sessions

    FROM events WHERE event_type IN ('\1', '\1') AND timestamp
    > ?

    GROUP BY system HAVING sessions > 5

    '
- applicable: all
  depends:
    event_types:
    - llm_invoke
    fields:
    - layer_llm.input_tokens
    - layer_llm.output_tokens
  description: LLM 调用频次和 Token 消耗呈 O(N²) 增长
  id: AGT-058
  layer: agent
  name: 多 Agent 通信开销爆炸
  per_system:
    opencode:
      enabled: false
  scope: observable
  severity: P1
  sql_template: "SELECT system, MAX(session_llm_cnt) as max_session_llm\nFROM (\n\
    \  SELECT system,\n         json_extract(payload, '$.layer_agent.session_id')\
    \ as session_id,\n         COUNT(*) as session_llm_cnt\n  FROM events WHERE event_type='llm_invoke'\
    \ AND timestamp > ?\n  GROUP BY system, session_id\n)\nGROUP BY system\nHAVING\
    \ max_session_llm > 400\n"
- applicable: all
  depends:
    event_types:
    - error
    fields:
    - system
    - timestamp
  description: 跨系统故障传播，单点故障影响多个 Agent
  id: AGT-059
  layer: agent
  name: 多 Agent 故障隔离失败
  scope: observable
  severity: P0
  sql_template: 'SELECT COUNT(DISTINCT system) as affected_systems, COUNT(*) as cnt

    FROM events WHERE event_type='error' AND timestamp > ?

    HAVING affected_systems > 2

    '
- applicable: all
  depends:
    event_types:
    - agent_step
    fields:
    - system
  description: 某系统 agent_step 远高于窗口均值（>2.5x），负载分配不均
  id: AGT-060
  layer: agent
  name: 任务分配不合理与负载失衡
  scope: observable
  severity: P2
  sql_template: 'SELECT system, COUNT(*) as cnt FROM events

    WHERE event_type='agent_step' AND timestamp > ?

    GROUP BY system HAVING cnt > (SELECT AVG(sub.cnt) FROM (SELECT COUNT(*) as cnt
    FROM events WHERE event_type='agent_step' AND timestamp > ? GROUP BY system)
    sub) * 2.5

    '
- applicable: all
  depends:
    event_types:
    - agent_step
    - llm_invoke
    fields:
    - layer_agent.session_id
  description: 多 Session 事件交织，并行任务处理可能混乱
  id: AGT-061
  layer: agent
  name: 并行任务处理混乱
  scope: observable
  severity: P1
  sql_template: 'SELECT system, COUNT(DISTINCT json_extract(payload, '\1'))
    as sessions

    FROM events WHERE event_type IN ('\1', '\1') AND timestamp
    > ?

    GROUP BY system HAVING sessions > 3

    '
- applicable: all
  depends:
    event_types:
    - error
    fields:
    - error_type
    - timestamp
  description: 同一错误类型频繁出现，可能引发级联崩盘
  id: AGT-062
  layer: agent
  name: 错误传播与级联崩盘
  scope: observable
  severity: P0
  sql_template: 'SELECT system, json_extract(payload, '\1') as error_type,
    COUNT(*) as cnt FROM events

    WHERE event_type='error' AND timestamp > ?

    GROUP BY system, json_extract(payload, '\1') HAVING cnt > 5

    '
- applicable: all
  depends:
    event_types:
    - error
    fields:
    - error_type
  description: 同一错误类型重复出现且无修复事件
  id: AGT-063
  layer: agent
  name: 开发失败恢复能力弱
  scope: observable
  severity: P0
  sql_template: 'SELECT system, json_extract(payload, '\1') as error_type,
    COUNT(*) as cnt FROM events

    WHERE event_type='error' AND timestamp > ?

    GROUP BY system, json_extract(payload, '\1') HAVING cnt > 5

    '
- applicable: all
  depends:
    event_types:
    - error
    - system_crash
    fields:
    - system
  description: 单点故障导致集群停滞，故障隔离失败
  id: AGT-064
  layer: agent
  name: 集群故障隔离与恢复失败
  scope: observable
  severity: P0
  sql_template: 'SELECT COUNT(DISTINCT system) as affected_systems

    FROM events WHERE event_type IN ('\1', '\1') AND timestamp >
    ?

    HAVING affected_systems > 3

    '
- applicable: all
  depends:
