{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "乾坤镜病症定义 Schema",
  "description": "config/diseases.yaml 校验规则。每个病症必须通过此 Schema 才能被分诊器和诊断器接受。",
  "type": "array",
  "minItems": 1,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "required": ["id", "name", "layer", "severity", "scope", "depends", "sql_template", "description"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "description": "病症唯一标识，格式：{层前缀}-{3位数字}",
        "pattern": "^(SYS|NET|MDL|TLT|AGT|MEM|PRB|DQT|BIZ)-[0-9]{3}$"
      },
      "name": {
        "type": "string",
        "description": "病症名称",
        "minLength": 2,
        "maxLength": 100
      },
      "layer": {
        "type": "string",
        "description": "所属层级",
        "enum": ["system", "network", "model", "tool", "agent", "memory", "probe", "data_quality", "business"]
      },
      "severity": {
        "type": "string",
        "description": "严重程度",
        "enum": ["P0", "P1", "P2"]
      },
      "scope": {
        "type": "string",
        "description": "诊断范围",
        "enum": ["observable", "mcp_required", "external_audit"]
      },
      "applicable": {
        "type": "string",
        "description": "适用系统",
        "enum": ["all", "yaoGuang", "tianYuan", "fanTianYin"]
      },
      "inference_mode": {
        "type": "string",
        "description": "推断模式：native（原生事件）或 shadow（影子推断）",
        "enum": ["native", "shadow"],
        "default": "native"
      },
      "native_event": {
        "type": "string",
        "description": "原生事件类型（inference_mode=shadow 时必填）"
      },
      "shadow_event": {
        "type": "string",
        "description": "影子事件类型（inference_mode=shadow 时必填）"
      },
      "shadow_sql": {
        "type": "string",
        "description": "影子模式 SQL 模板，必须以 SELECT 开头，同样受 SQL 闸门约束",
        "pattern": "^\\s*SELECT\\s+"
      },
      "depends": {
        "type": "object",
        "required": ["event_types", "fields"],
        "additionalProperties": false,
        "properties": {
          "event_types": {
            "type": "array",
            "description": "依赖的事件类型列表",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "minItems": 1
          },
          "fields": {
            "type": "array",
            "description": "依赖的 payload 字段路径列表，格式：layer_name.field_name",
            "items": {
              "type": "string",
              "pattern": "^[a-z_]+(\\.[a-z_]+)*$"
            }
          }
        }
      },
      "sql_template": {
        "type": "string",
        "description": "诊断 SQL 模板，必须以 SELECT 开头，仅允许单表查询（禁 JOIN/UNION/PRAGMA/写操作）",
        "minLength": 15
      },
      "description": {
        "type": "string",
        "description": "病症描述",
        "minLength": 5,
        "maxLength": 500
      }
    },
    "allOf": [
      {
        "if": {
          "properties": { "inference_mode": { "const": "shadow" } }
        },
        "then": {
          "required": ["native_event", "shadow_event", "shadow_sql"]
        }
      }
    ]
  }
}
